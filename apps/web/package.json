{
  "name": "@slideops/web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "The SlideOps web application: the marketing site, the Operator dashboard, and the Admin control plane, one React app with role-based routing on a single port.",
  "scripts": {
    "dev": "vite --port 4321",
    "build": "vite build",
    "preview": "vite preview --port 4321",
