####################################################################################
# SlideOps web app — environment reference
#
# Copy this to .env and edit. Everything the web app reads is listed here, so
# nothing has to be discovered by reading source.
#
#   cp .env.example .env
#
# ⚠ EVERY VITE_ VALUE IS BAKED INTO THE PUBLIC BUNDLE AT BUILD TIME AND IS
#   READABLE BY ANYONE WHO LOADS THE PAGE. Never put a secret here — no API key,
#   no token, no password. Secrets belong in the backend's .env, which the browser
#   never sees.
#
# Vite only exposes variables prefixed VITE_. That is the guard rail; do not work
# around it.
####################################################################################


####################################################################################
# 1. WHERE THE BACKEND IS  — the one you actually need
####################################################################################

# The base the app makes every API call against. Two shapes are accepted, and
# which you choose decides how the deployment is wired.
#
# ── A. Same origin (the default, and the one to prefer) ────────────────────────
#
#   VITE_API_BASE_URL=/api/v1
#
# The app and the API are served from one origin — a reverse proxy in front of
# both, or the API serving the built app. The session cookie is same-site, no CORS
# is involved, and nothing else needs configuring. Leave the default alone.
#
# ── B. Backend deployed somewhere else ─────────────────────────────────────────
#
#   VITE_API_BASE_URL=https://api.yourdomain.com/api/v1
#
# The API lives on its own host. This works, and it is what lets you deploy the
# backend anywhere, but TWO THINGS MUST BE SET ON THE BACKEND or sign in will
# appear to succeed and then every request will look signed out:
#
#   1. CORS_ALLOWED_ORIGINS must name this app's origin, exactly:
#        CORS_ALLOWED_ORIGINS=https://app.yourdomain.com
#      That permits credentialed calls AND switches the session cookie to
#      SameSite=None with Secure, so the browser will actually send it.
#
#   2. BOTH sides must be HTTPS. Browsers only honour a SameSite=None cookie when
#      it is also Secure, so cross-origin will not work over plain http — not even
#      on localhost. Locally, use the dev proxy in section 2 instead.
#
# Include the /api/v1 path; the app appends endpoint paths to whatever you give.
# A trailing slash is trimmed for you. The live event stream follows this too, so
# a cross-origin backend gets its websocket opened against the backend rather than
# against wherever the page happens to be served from.
#
# [default: /api/v1]
VITE_API_BASE_URL=/api/v1

# Older name for the same thing, still honoured so an existing deployment keeps
# working. If both are set, VITE_API_BASE_URL wins. Prefer the name above.
# VITE_API_BASE=/api/v1


####################################################################################
# 2. LOCAL DEVELOPMENT
####################################################################################
#
# In development the Vite dev server proxies /api to your backend, so the app and
# the API share an origin from the browser's point of view. That means the session
# cookie just works and none of the cross-origin machinery in section 1B applies.
#
# Leave VITE_API_BASE_URL at /api/v1 for local work and set the proxy target here.

# Where the dev server forwards /api to.
# [default: http://localhost:8090]
#
#   docker compose (backend/docker-compose.yml publishes 8090):
#     VITE_DEV_API_PROXY_TARGET=http://localhost:8090
#   go run ./cmd/slideops-api directly (PORT defaults to 8080):
#     VITE_DEV_API_PROXY_TARGET=http://localhost:8080
#   a backend on another machine on your network:
#     VITE_DEV_API_PROXY_TARGET=http://192.168.1.50:8080
# VITE_DEV_API_PROXY_TARGET=http://localhost:8090

# Port the dev server listens on. Change it if 4321 is taken.
# [default: 4321]
# VITE_DEV_PORT=4321


####################################################################################
# 3. SIGNING IN WITH GITHUB — nothing to configure here
####################################################################################
#
# GitHub sign in needs no frontend variable at all. The app links to
# `<API base>/auth/github/authorize` and the backend owns the whole round trip,
# which is precisely why the OAuth client secret never has to exist in a bundle
# anyone can read.
#
# Configure it entirely on the backend:
#   GITHUB_OAUTH_CLIENT_ID, GITHUB_OAUTH_CLIENT_SECRET, PUBLIC_BASE_URL
#
# The app asks GET /github/status whether the feature is configured and hides the
# GitHub button when it is not, so an unconfigured deployment shows nothing broken.


####################################################################################
# 4. WHERE ELSE TO LOOK
####################################################################################
#
#   Backend variables:  backend/.env.example  — the database, Redis, the secret
#                       key, admin emails, GitHub OAuth, email, and payments.
#   API reference:      <backend origin>/docs — every endpoint, documented.
####################################################################################
